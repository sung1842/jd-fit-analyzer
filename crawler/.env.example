# 이 파일을 crawler/.env 로 복사해 채운다. 크롤러는 crawler/.env 만 읽는다 (루트 .env.local 은 읽지 않는다).
# 실제 비밀값을 이 파일(.env.example)에 넣지 말 것.

# talentfolio Supabase 프로젝트의 **직접 Postgres 접속 문자열** (Dashboard → Connect → Session pooler 권장, 포트 5432)
# PostgREST(supabase-js)로는 COPY 를 못 쓴다. COPY 는 반드시 DB 소켓으로 간다.
# 자식 크롤 프로세스에는 전달되지 않는다(부모가 gate 통과 후 적재할 때만 사용).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres


# 적재 대상 스키마 (010_single_db_fit_schema.sql 과 동일)
FIT_DB_SCHEMA=fit

# ---- HTTP 트리거 (FastAPI) ----
# talentfolio 3000, orchestrator 3001, mcp 3002, jd-fit web 3010 과 겹치지 않음.
CRAWLER_API_HOST=127.0.0.1
CRAWLER_API_PORT=8010

# 필수. 헤더 x-internal-key 값. 비어 있으면 서버가 기동을 거부한다(fail-closed). MCP_INTERNAL_KEY 로 폴백하지 않는다.
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
CRAWLER_API_KEY=

# 127.0.0.1 / ::1 / localhost 가 아닌 주소로 바인드하려면 1 로 설정 (기본: 비워둠 = loopback 만 허용)
CRAWLER_ALLOW_NON_LOOPBACK=

# ---- Crawl4AI 사이트 어댑터 (source=site) — 쓰기 전까지 비워둬도 된다 ----
# 필수(둘 중 하나): 식별 가능한 User-Agent 를 위한 연락처(이메일/URL). 둘 다 없으면 어댑터가 실행을 거부한다.
CRAWLER_CONTACT=
# 직접 UA 전체를 지정하려면 (CRAWLER_CONTACT 대신). 브라우저로 위장한 UA 는 쓰지 말 것.
CRAWLER_USER_AGENT=
# 요청 간 랜덤 지연 범위(초). 기본 3~7
CRAWL_DELAY_MIN=3
CRAWL_DELAY_MAX=7

