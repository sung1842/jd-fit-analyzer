# talentfolio Supabase (읽기 전용)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 분석 에이전트용 (Gemini Flash, 저비용)
GEMINI_API_KEY=

# CEO 에이전트용 (Claude Sonnet, 최종 판단)
ANTHROPIC_API_KEY=

# true면 CEO 에이전트(Anthropic API) 호출 없이 가중 평균으로 결과를 합성 (무료 테스트용)
CEO_MOCK=false

# jd-fit-analyzer 자체 Supabase (fit_reports/HIL 상태 저장, 읽기/쓰기)
FIT_ANALYZER_SUPABASE_URL=
FIT_ANALYZER_SUPABASE_ANON_KEY=
FIT_ANALYZER_SUPABASE_SERVICE_ROLE_KEY=

# 비동기 큐
REDIS_URL=redis://localhost:6379

# Langfuse (LLM 트레이싱, Phase 4) — 비워두면 비활성화
# 리전별 base URL: EU=https://cloud.langfuse.com, US=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Phase 5: B2B 사내 소싱 — Slack Bot Token (OAuth, chat:write scope 필요)
SLACK_BOT_TOKEN=

# Phase M2: Slack 인터랙티비티(승인 버튼 콜백) 서명 검증용
# Slack App > Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=

# Phase M2: Slack App > Interactivity 에 등록한 Request URL (공개 HTTPS, ngrok 등)
# SLACK_SIGNING_SECRET과 둘 다 설정돼야 ✅/❌ 인터랙티브 버튼을 보냄. 미설정 시 웹 승인 링크만 전송.
SLACK_INTERACTIVITY_URL=https://xxxx.ngrok-free.app/api/slack/interactivity

# Phase M2: Slack 웹 승인 링크 폴백용 talentfolio 주소
TALENTFOLIO_URL=http://localhost:3000

# Phase M4: Notion Public Integration OAuth (developers.notion.com)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3001/api/notion/oauth/callback
